{
  "schemaVersion": 1,
  "name": "auditforge",
  "displayName": "AuditForge",
  "version": "0.1.0",
  "description": "SOC 2 and multi-framework GRC auditing: knowledge-base skills, audit commands, and the control-search MCP server.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "auditforge",
        "path": "skills/auditforge/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "security-audit",
        "path": "skills/security-audit/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [
      {
        "id": "audit",
        "path": "commands/audit.md",
        "enabledDefault": true
      },
      {
        "id": "freshness",
        "path": "commands/freshness.md",
        "enabledDefault": true
      }
    ],
    "hooks": [],
    "mcpServers": [
      {
        "id": "auditforge",
        "transport": "stdio",
        "command": [
          "python3",
          "mcp/server.py"
        ]
      }
    ],
    "reminders": []
  }
}
