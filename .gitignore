# Project-owned code is tracked; everything else stays local.
# Nested knowledge bases are independent clones (pull-to-update via
# scripts/update_sources.ps1) - deliberately NOT submodules (ADR-301).
asvs/
attack-stix-data/
comp-ai/
compliance-as-code/
comply/
gdpr-checklist/
juice-shop/
jupiterone-policies/
nist-csf/
opengrc/
oscal-content/
owasp-top10/
probo/
secure-controls-framework/
security-templates/

# generated / ephemeral
reports/
graphify-out/
__pycache__/
*.pyc
*.sarif
*.baseline

# cached raw documents from scripts/build_document_catalog.py --cache -
# even "free_to_access" sources often restrict redistribution (see
# document_catalog.db's license_note column), so these stay local-only.
# document_catalog.db itself (metadata + URLs, no document bodies) is
# tracked, same convention as framework_metadata.json.
scripts/document_cache/

# secrets
.env

# tooling state
.recurspec/
