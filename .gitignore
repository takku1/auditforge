# Project-owned code is tracked; everything else stays local.
# Nested knowledge bases are independent clones (pull-to-update via
# scripts/update_sources.ps1) - deliberately NOT submodules (ADR-301).
asvs/
attack-stix-data/
comp-ai/
compliance-as-code/
comply/
gdpr-checklist/
juice-shop/
jupiterone-policies/
nist-csf/
opengrc/
oscal-content/
owasp-top10/
probo/
secure-controls-framework/
security-templates/
fedramp-rules/

# generated / ephemeral
reports/
graphify-out/
__pycache__/
*.pyc
*.sarif
*.baseline

# cached raw documents from scripts/build_document_catalog.py --cache -
# even "free_to_access" sources often restrict redistribution (see
# document_catalog.db's license_note column), so these stay local-only.
# document_catalog.db itself (metadata + URLs, no document bodies) is
# tracked, same convention as framework_metadata.json.
scripts/document_cache/
scripts/document_cache_run.log

# scripts/vector_index.db is DERIVED (regenerate via build_vector_index.py)
# but, unlike framework_metadata.json/document_catalog.db, it's too large
# for git (400+MB - embeds chunked text extracted from scripts/document_cache/,
# which is itself gitignored for redistribution-rights reasons above) and
# is trivially rebuildable locally in a few minutes.
scripts/vector_index.db
scripts/vector_index.db-*
scripts/vector_rebuild*.log

# vuln_intel.py's local API-response cache (CISA KEV/EPSS/NVD) - ephemeral,
# TTL'd, regenerates itself on first use.
scripts/vuln_intel_cache.db

# agentic-layer virtualenv - never commit a venv (see requirements.txt)
.venv/

# HuggingFace model cache, if pointed here instead of the user profile
.cache/

# secrets
.env

# tooling state
.recurspec/
.claude-flow/
.claude/scheduled_tasks.lock
