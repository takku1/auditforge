# ==============================================================================
# UNIVERSAL COMPLIANCE ORCHESTRATOR - ENVIRONMENT TEMPLATE
# 100% Open Source / Free Tier Configuration
# ==============================================================================

# [!] ENTERPRISE APIS ARE STRICTLY DISABLED
# This orchestrator is aggressively designed for local, open-source execution.
# - Semgrep Pro/Enterprise APIs require paid licenses and are OFF THE TABLE.
# - Prisma Cloud / Bridgecrew APIs for Checkov are OFF THE TABLE.
# The orchestrator will actively strip these tokens from the execution context.

# ------------------------------------------------------------------------------
# NETWORK & PROXY CONFIGURATION
# ------------------------------------------------------------------------------
# If you are operating behind a corporate firewall, define proxy variables here
# so that the DAST API scanner and framework sync script can reach the internet:
# HTTP_PROXY=http://proxy.internal:8080
# HTTPS_PROXY=http://proxy.internal:8080
# NO_PROXY=localhost,127.0.0.1,api.internal.local

# If your company uses SSL inspection, provide the path to your internal CA bundle:
# REQUESTS_CA_BUNDLE=/path/to/corporate/ca-bundle.crt
# SSL_CERT_FILE=/path/to/corporate/ca-bundle.crt

# ------------------------------------------------------------------------------
# ORCHESTRATOR TUNING
# ------------------------------------------------------------------------------
# Default timeout for DAST/Network checks in seconds (prevents hanging on dead IPs)
DAST_REQUEST_TIMEOUT=10

# Default User-Agent for DAST scanner to bypass basic WAF blocks
DAST_USER_AGENT="AuditForge/1.0 (SecurityAudit)"

# Python internal configurations
PYTHONUTF8=1
