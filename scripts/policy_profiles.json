{"_comment": "Required governance/policy document catalog for policy_audit.py. Each entry is a policy an auditor expects to FIND in the target repo (docs/, policies/, *.md). families must be key prefixes present in framework_metadata.json (else citations land in unresolved_refs). keywords match against file contents; files_any match against repo-relative paths.", "policies": [{"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*access*control*", "*access*policy*", "*provision*"], "id": "access-control", "keywords": ["access control", "least privilege", "provisioning", "deprovisioning", "access review"], "must": true, "title": "Access Control Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*auth*", "*password*", "*mfa*", "*credential*"], "id": "authentication", "keywords": ["multi-factor", "password", "authentication", "credential", "single sign-on"], "must": true, "title": "Authentication & Password Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*crypt*", "*encrypt*", "*key*management*", "*kms*"], "id": "encryption", "keywords": ["encryption", "key management", "aes-256", "tls 1.2", "at rest", "in transit"], "must": true, "title": "Encryption & Key Management Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*network*", "*firewall*", "*vpn*"], "id": "network-security", "keywords": ["firewall", "network segmentation", "vpn", "ingress", "egress"], "must": true, "title": "Network Security Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*log*", "*monitor*", "*siem*", "*audit*log*"], "id": "logging-monitoring", "keywords": ["logging", "monitoring", "audit log", "siem", "alerting"], "must": true, "title": "Logging & Monitoring Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*incident*", "*breach*", "*response*plan*"], "id": "incident-response", "keywords": ["incident response", "breach notification", "containment", "eradication", "post-incident"], "must": true, "title": "Incident Response Plan"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*change*management*", "*change*control*", "*deployment*policy*"], "id": "change-management", "keywords": ["change management", "change approval", "deployment", "rollback", "separation of duties"], "must": true, "title": "Change Management Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53", "CSF2"], "files_any": ["*vuln*", "*patch*", "*pentest*"], "id": "vulnerability-management", "keywords": ["vulnerability management", "patching", "vulnerability scan", "remediation sla", "penetration test"], "must": true, "title": "Vulnerability Management Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*privacy*", "*data*classification*", "*retention*", "*data*handling*"], "id": "data-privacy", "keywords": ["data classification", "retention", "personal data", "pii", "data subject"], "must": true, "title": "Data Classification, Privacy & Retention Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*vendor*", "*third*party*", "*supplier*", "*subservice*"], "id": "vendor-management", "keywords": ["vendor", "third-party", "due diligence", "subservice organization", "supply chain"], "must": true, "title": "Vendor / Third-Party Management Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*continuity*", "*disaster*", "*backup*policy*", "*bcp*", "*drp*"], "id": "business-continuity", "keywords": ["business continuity", "disaster recovery", "backup", "rto", "rpo"], "must": true, "title": "Business Continuity & Disaster Recovery Plan"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53", "CSF2"], "files_any": ["*risk*assessment*", "*risk*management*", "*risk*register*"], "id": "risk-assessment", "keywords": ["risk assessment", "risk register", "risk treatment", "likelihood", "impact"], "must": true, "title": "Risk Assessment & Management Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*acceptable*use*", "*aup*"], "id": "acceptable-use", "keywords": ["acceptable use", "prohibited", "personal use", "user responsibilities"], "must": false, "title": "Acceptable Use Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53"], "files_any": ["*physical*", "*facility*", "*clean*desk*"], "id": "physical-security", "keywords": ["physical security", "facility", "badge", "visitor", "clean desk"], "must": false, "title": "Physical & Environmental Security Policy"}, {"families": ["SCF_GENERAL_AICPA_TSC_2017", "NIST53", "CSF2"], "files_any": ["*sdlc*", "*secure*development*", "*secure*coding*"], "id": "secure-development", "keywords": ["secure development", "secure coding", "code review", "sdlc", "static analysis"], "must": false, "title": "Secure Development Policy"}]}