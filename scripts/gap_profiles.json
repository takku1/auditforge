      {"id": "authorization", "title": "Per-resource authorization (not just authn)", "must": true, "families": ["ASVS", "NIST53"], "keywords": ["authorization", "access control"], "files_any": ["*auth*", "*polic*", "*guard*"], "rules_any": ["IAM001"]},
