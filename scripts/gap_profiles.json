      {"id": "rate-limiting", "title": "Rate limiting / anti-automation", "must": true, "families": ["ASVS"], "keywords": ["rate limit", "anti-automation", "excessive"], "files_any": ["middleware.*", "*ratelimit*"], "rules_any": ["WEB004"]},
      {"id": "tls-transport", "title": "TLS-only transport, no cleartext", "must": true, "families": ["ASVS", "NIST53"], "keywords": ["transport", "encrypted communicat"], "files_any": ["Dockerfile*", "docker-compose*", "*.tf"], "rules_any": ["NET001", "NET004", "NET002"]},
      {"id": "cors-policy", "title": "Explicit CORS / origin policy", "must": true, "families": ["ASVS"], "keywords": ["cross-origin", "origin"], "files_any": ["middleware.*", "*cors*"], "rules_any": ["WEB005"]},
