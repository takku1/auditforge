{
  "_comment": "Domain profiles for scripts/gap_analysis.py. Each capability names the framework families + keywords used to pull live citations from framework_metadata.json (families that do not resolve are reported, never silently dropped), file globs that count as repo evidence, and native rule IDs whose firing means the risk was observed. must=true + no evidence = must-build gap. Web is one profile among all - no domain is the template.",
  "website": {
    "label": "Public website / web app",
    "capabilities": [
      {"id": "headers-config", "title": "Security-headers config shipped", "must": true, "families": ["ASVS", "CSF2"], "keywords": ["security header", "strict-transport", "content-security"], "files_any": ["_headers", "vercel.json", "netlify.toml", "next.config.*", "nginx.conf", "Caddyfile"], "rules_any": ["WEB001", "NET_HSTS_MISSING", "NET_CSP_MISSING"]},
      {"id": "csp-enforced", "title": "Content-Security-Policy enforced (not report-only)", "must": true, "families": ["ASVS"], "keywords": ["content-security"], "files_any": ["_headers", "vercel.json", "netlify.toml"], "rules_any": ["WEB002", "NET_CSP_MISSING"]},
      {"id": "tls-hsts", "title": "TLS with HSTS enforced", "must": true, "families": ["ASVS", "NIST53"], "keywords": ["strict-transport", "hsts", "transport"], "files_any": ["_headers", "vercel.json", "netlify.toml", "nginx.conf", "Caddyfile"], "rules_any": ["NET001", "NET004", "NET_HSTS_MISSING"]},
      {"id": "origin-checks", "title": "State-changing endpoints verify origin/CSRF", "must": true, "families": ["ASVS"], "keywords": ["cross-origin", "samesite", "anti-automation"], "files_any": ["middleware.*", "csrf*", "*csrf*"], "rules_any": ["WEB005"]},
      {"id": "rate-limiting", "title": "Per-endpoint rate limiting", "must": true, "families": ["ASVS"], "keywords": ["rate limit", "anti-automation", "excessive"], "files_any": ["*ratelimit*", "*rate-limit*", "middleware.*"], "rules_any": ["WEB004"]},
      {"id": "authn-session", "title": "Authentication and session handling (if accounts exist)", "must": false, "families": ["ASVS", "NIST53"], "keywords": ["authentication", "session terminat", "credential"], "files_any": ["*auth*", "*login*", "*session*", "middleware.*"], "rules_any": []},
      {"id": "output-encoding", "title": "Output encoding at sinks (no raw innerHTML)", "must": true, "families": ["ASVS"], "keywords": ["output encoding", "cross-site script"], "files_any": [], "rules_any": ["WEB003", "SDLC001"]},
      {"id": "secret-management", "title": "No hardcoded secrets; env/secret manager", "must": true, "families": ["ASVS"], "keywords": ["secret assets", "secrets management"], "files_any": [".env.example", "wrangler.toml", ".env*"], "rules_any": ["SEC001", "SEC002", "SEC004", "SEC005", "SEC006", "SEC007", "SEC008", "SEC009", "TRUFFLEHOG_VERIFIED_SECRET"]},
      {"id": "security-logging", "title": "Security event logging (no PII in logs)", "must": true, "families": ["ASVS"], "keywords": ["logging", "sensitive data"], "files_any": ["*log*", "middleware.*"], "rules_any": ["LOG001", "PII001"]},
      {"id": "dependency-scanning", "title": "Dependency scanning in CI", "must": true, "families": ["CSF2", "NIST53"], "keywords": ["vulnerabilit", "supply chain", "component"], "files_any": ["package.json", "package-lock.json", "pnpm-lock.yaml", ".github/workflows/*", ".gitlab-ci.yml"], "rules_any": ["DEP_VULN"]},
      {"id": "error-handling", "title": "Safe error handling (no stack leaks)", "must": false, "families": ["ASVS"], "keywords": ["error handling", "stack trace"], "files_any": ["middleware.*", "*error*"], "rules_any": []}
    ]
  },
  "api-service": {
