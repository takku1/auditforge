      {"id": "dependency-scanning", "title": "Dependency + image scanning", "must": true, "families": ["CSF2"], "keywords": ["vulnerabilit", "component"], "files_any": ["requirements.txt", "package.json", "go.mod", "Cargo.lock", "Gemfile", "Dockerfile*"], "rules_any": ["DEP_VULN"]}
    ]
  },
